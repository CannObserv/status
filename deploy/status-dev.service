[Unit]
Description=co-status (dev) — non-production API on port 9001
After=network.target postgresql.service tailscaled.service

# The launch script exits non-zero by design when status_dev is unreachable
# or unmigrated (notifier#23). Without a bound that is a restart loop in the journal
# forever; with too tight a bound, a slow Postgres at boot exhausts the tries
# and the unit stays failed until someone runs `systemctl reset-failed` —
# turning a transient into a silently dead endpoint, the opposite of what this
# unit is for. After= orders startup but does not wait for the cluster to
# accept connections, so the window has to ride that race out.
#
# Since notifier#43 this unit also waits on tailscaled for its bind address, which
# scripts/tailnet_bind.sh bounds internally before failing the start.
#
# 5 tries x RestartSec=15 = 75s of retries. Long enough for any plausible boot
# race; short enough that a real misconfiguration, which no amount of waiting
# fixes, still gives up somewhere a human will see it.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=exedev
# A release, never a checkout (#9): scripts/deploy.sh builds read-only releases
# under /srv/status/releases and swaps this symlink. Nothing done in the
# development checkout reaches this unit until it is deployed.
# Dev is deployed like live, any pushed ref (R12); the hand-run inner loop is
# scripts/dev_server.sh from a worktree, after `sudo systemctl stop status-dev`.
# /health on :9001 names the release's REVISION (src/core/build.py).
WorkingDirectory=/srv/status/dev

# Deliberately NO STATUS_ALLOW_PROD_DB here. The production opt-in belongs
# to status.service alone. Non-production check-ins point at this endpoint;
# the entire value of a development-marked key
# is that it cannot reach production, and inheriting the opt-in would undo it.
# tests/deploy/test_dev_systemd_unit.py asserts this stays absent.
Environment=STATUS_DEV_RELOAD=0

# notifier's development key, for notifier :9001 (spec D13). Its own file, not
# the production one: notifier refuses a development key on :9000, and a
# production key has no business reaching notifier_dev.
LoadCredential=notifier-key:/etc/status/notifier-api-dev.key

# DEV_DATABASE_URL, and nothing else (#9, R11). The script sources
# /etc/status/.env itself and then overrides DATABASE_URL with it; loading
# /etc/status/.env here too would re-import the production DATABASE_URL one
# layer earlier for no gain. Never a repo .env: a release has none, and the
# development checkout's carries PATs and API keys.
EnvironmentFile=/etc/status/dev.env
#
# ExecStart is the guarded script, never a hand-rolled uvicorn line. The
# script unsets the production opt-in, swaps in DEV_DATABASE_URL, delegates
# the URL check to src.core.db_safety, and refuses an unmigrated database.
# A second uvicorn spelling here would be a second code path that can drift
# out from under all four checks (issues notifier#22, notifier#23, notifier#24).
ExecStart=/srv/status/dev/scripts/dev_server.sh

Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
