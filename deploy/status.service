[Unit]
Description=co-status — dead-man's timers for the cohort, alerting through notifier
After=network.target postgresql.service tailscaled.service

# The service binds this host's tailnet address alone (notifier#43 D3), so a start that
# beats tailscaled to an address cannot bind at all. After= orders the two but
# does not wait for the address — scripts/tailnet_bind.sh does that, and gives
# up non-zero rather than falling back to a bind reachable from elsewhere.
#
# Which means every failed start now costs the full tailnet wait *before*
# RestartSec begins. systemd's default StartLimitIntervalSec is 10s, far too
# short to ever count restarts that far apart, so without an explicit bound a
# genuinely broken configuration would retry forever — the same silently-dead
# endpoint status-dev.service bounds itself against, arriving by a different
# route. 5 tries x (60s wait + 5s) = ~325s of retries inside a 900s window:
# long enough to ride out tailscaled and Postgres at boot, short enough that a
# real misconfiguration gives up somewhere a human will see it.
StartLimitIntervalSec=900
StartLimitBurst=5

# No OnFailure= (#13). A unit that gives up here is still seen from outside:
# every production sweep pass asks http://status:9000/ready and pings
# healthchecks.io's co-status-api, which also catches the crash loop before the
# limit, and an API that is up but not ready. RUNBOOK § Watching co-status.

[Service]
Type=simple
User=exedev
# A release, never a checkout (#9): scripts/deploy.sh builds read-only releases
# under /srv/status/releases and swaps this symlink. Nothing done in the
# development checkout reaches this unit until it is deployed.
WorkingDirectory=/srv/status/live

# The production database opt-in for src/core/db_safety.py. This MUST stay in
# the unit and never move into an EnvironmentFile below — anything in those
# files is inherited by every shell that sources them, which would re-open the
# hole for exactly the hand-run servers the guard targets (issue notifier#22).
Environment=STATUS_ALLOW_PROD_DB=1

# Memory reservation (notifier#74). This host is 7.9 GiB with no swap (sized
# on notifier's 3.8 GiB) and runs the live service, the dev endpoint,
# PostgreSQL and interactive agent sessions on one kernel. The failure this
# prevents is not an OOM kill — it is the absence of one: past the ceiling the
# kernel fails *atomic* allocations in whatever asks next (tailscaled,
# ksoftirqd) and the production service is what goes down.
#
# MemoryLow is a soft floor, not a cap. A cap here would be the wrong tool
# twice: it bounds the victim rather than the cause, and on a process the
# killer will not pick it stalls instead of killing. 192M against a measured
# 90 MiB peak — room for the working set, not a reservation of idle pages.
#
# Inert on its own (notifier#85): a unit keeps at most what every slice above it
# grants, and system.slice ships 0. deploy/system.slice.d/ is the grant; read
# the effective value, never this one (notifier's docs/reference/memory-reservation.md).
MemoryLow=192M

# Negative so the killer prefers almost anything else. That puts production
# last in line only while agent sessions sit at adj 0; an old exe-init starts
# them at -1000, unkillable, which inverts the order (#5). Deliberately not -1000:
# unkillable turns a leak here into a wedged host with no kill and no report.
OOMScoreAdjust=-500

# The notifier API key (spec D13): co-status's one delivery secret, read by
# src/core/alerting.py from $CREDENTIALS_DIRECTORY/notifier-key. A credential,
# never an EnvironmentFile line: those are inherited by every process that
# sources them and show up in /proc/<pid>/environ. A missing source file fails
# the start, loudly, rather than serving a co-status that cannot alert.
# tests/deploy/test_notifier_credential.py holds this.
LoadCredential=notifier-key:/etc/status/notifier-api.key

# Production's env file alone (#9, R11). Never a repo .env: the development
# checkout's carries PATs and API keys, and a release has none. The build id
# is the release's REVISION, read by the app (src/core/build.py).
EnvironmentFile=/etc/status/.env

# Never a uvicorn line here. Besides the one-spelling rule status-dev.service
# has held since notifier#24, systemd reads every EnvironmentFile= *before* ExecStartPre
# runs — so no ExecStartPre can resolve this host's tailnet address into the
# environment ExecStart would see. Resolving and binding must share a process.
ExecStart=/srv/status/live/scripts/serve.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
